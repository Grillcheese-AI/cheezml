>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#RelationMissing">
    <skos:prefLabel xml:lang="en">relation missing</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#RefusalReasons"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#conflictKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#Refusal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:scopeNote xml:lang="en">Values come from the code list cubby:ConflictKinds.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">conflictKind</rdfs:label>
    <skos:definition xml:lang="en">Kind of conflict; required exactly when the reason is cubby:Conflict.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#PrerequisiteCheck">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
    <skos:definition xml:lang="en">Exact prerequisite check of a story-world action (0060).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#SecondApprover">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#ReviewerRoles"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:prefLabel xml:lang="en">second approver (above the amount)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#GainCheck">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:definition xml:lang="en">A domain change shows a gain (0058).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/cheezml/cubby/v0.2"/>
    <owl:priorVersion rdf:resource="https://w3id.org/cheezml/cubby/v0.1"/>
    <owl:versionInfo>0.2 (draft)</owl:versionInfo>
    <dcterms:title xml:lang="en">CheezML for CubbyLLM</dcterms:title>
    <dcterms:description xml:lang="en">Conversation turns, answers and refusals with their reasons, proposers, helpers in a sandbox, and documents reviewed by a person.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-07</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</dcterms:modified>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:creator rdf:nodeID="N520ca96d73cd4367ae238969d5016e8e"/>
    <vann:preferredNamespacePrefix>cubby</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/cheezml/cubby#</vann:preferredNamespaceUri>
    <owl:imports rdf:resource="https://w3id.org/cheezml/core"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#ConflictKinds">
    <skos:prefLabel xml:lang="en">Kinds of conflict</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#refusalReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#Refusal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:scopeNote xml:lang="en">Values come from the code list cubby:RefusalReasons.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">refusalReason</rdfs:label>
    <skos:definition xml:lang="en">Why the question was refused.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#SupplierCheck">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
    <skos:definition xml:lang="en">Exact supplier check (0061).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#DatesTooCoarse">
    <skos:prefLabel xml:lang="en">dates too coarse</skos:prefLabel>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#RefusalReasons"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#dialogueAct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#Turn"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:scopeNote xml:lang="en">Values come from the code list cubby:DialogueActs.</skos:scopeNote>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">dialogueAct</rdfs:label>
    <skos:definition xml:lang="en">The turn's dialogue act.</skos:definition>
    <skos:editorialNote xml:lang="en">ISO 24617-2 mapping pending (IRIs not known)</skos:editorialNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#decision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#Turn"/>
    <rdfs:range rdf:resource="https://w3id.org/cheezml/core#Decision"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">decision</rdfs:label>
    <skos:definition xml:lang="en">The answer or refusal the turn delivered.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#Proposers">
    <skos:prefLabel xml:lang="en">Proposers in use</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#turnIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#Turn"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">turnIndex</rdfs:label>
    <skos:definition xml:lang="en">Host-assigned position in the conversation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc6524090e8cb4cc1b9ab88681b038aad">
    <rdf:first rdf:resource="https://w3id.org/cheezml/core#Option"/>
    <rdf:rest rdf:nodeID="Nb9c47f4f7b2142d185c9fc023199e3cf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#Ambiguous">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#RefusalReasons"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:prefLabel xml:lang="en">ambiguous</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#ScopeCheck">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:definition xml:lang="en">A helper changes nothing outside its scope (0062).</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#readerVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#DocumentRegion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">readerVersion</rdfs:label>
    <skos:definition xml:lang="en">Version of the reader that produced the region.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#Answer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">Answer</rdfs:label>
    <skos:definition xml:lang="en">A delivered answer (value in prov:value); always has a certificate.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cheezml/core#Decision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#PurchaseOrderCheck">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
    <skos:definition xml:lang="en">Exact purchase-order check (0061).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#LogicalConflict">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#ConflictKinds"/>
    <skos:prefLabel xml:lang="en">logical</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="N4d85c278bbc84948b8b397c73f4dec85"/>
    <rdfs:range rdf:resource="https://w3id.org/cheezml/cubby#DocumentRegion"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">region</rdfs:label>
    <skos:definition xml:lang="en">The region a suggestion or review refers to.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#OvernightRuleLibrary">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#Proposers"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:prefLabel xml:lang="en">overnight rule library</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#DocumentRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">DocumentRegion</rdfs:label>
    <skos:definition xml:lang="en">A region of a document: text as read (schema:text), reader version, document (schema:isPartOf).</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#scope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#Helper"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">scope</rdfs:label>
    <skos:definition xml:lang="en">The verified answers the helper must reproduce.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#TypeConflict">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#ConflictKinds"/>
    <skos:prefLabel xml:lang="en">type</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#FieldSuggestion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">FieldSuggestion</rdfs:label>
    <skos:definition xml:lang="en">A value read or derived for a document field (prov:value); a suggestion until committed.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#HelperRejection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">HelperRejection</rdfs:label>
    <skos:definition xml:lang="en">The host's rejection of a helper after its sandbox run; reason = the failed gate's kind.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cheezml/core#Retirement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#CertifiedAnswerAct">
    <skos:prefLabel xml:lang="en">certified answer</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#DialogueActs"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N55dbf3362c334fb9a0939dce5507d517">
    <rdf:first rdf:resource="https://w3id.org/cheezml/cubby#FieldSuggestion"/>
    <rdf:rest rdf:nodeID="Nd2b2366a6686477fb4ade89291cb3077"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#Turn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">Turn</rdfs:label>
    <skos:definition xml:lang="en">One conversation turn, written by the host; conversation via schema:isPartOf.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#TemporalConflict">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#ConflictKinds"/>
    <skos:prefLabel xml:lang="en">temporal</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#DatePrecisionCheck">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
    <skos:definition xml:lang="en">Dates used are fine enough for the question (inferred from 'dates too coarse').</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N520ca96d73cd4367ae238969d5016e8e">
    <rdf:type rdf:resource="https://schema.org/Person"/>
    <schema:name>Nicolas Cloutier</schema:name>
    <schema:affiliation>GrillCheese Research Lab</schema:affiliation>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N71a55fd998bd4992ba937f69f380b8e7">
    <rdf:first rdf:resource="https://w3id.org/cheezml/cubby#Refusal"/>
    <rdf:rest rdf:nodeID="Nc6524090e8cb4cc1b9ab88681b038aad"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#Helper">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">Helper</rdfs:label>
    <skos:definition xml:lang="en">A helper program proposed by Cubby's own proposers (order 0062).</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cheezml/cubelang#Program"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#NoNewWrongAnswerCheck">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
    <skos:definition xml:lang="en">A domain change introduces no new wrong answer (0058).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#breakingCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/cheezml/cubby#HelperRejection"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">breakingCase</rdfs:label>
    <skos:definition xml:lang="en">The case that broke the helper.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#ConflictCheck">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/core#CheckKinds"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:definition xml:lang="en">No value, type, temporal, logical or recorded-against-derived conflict among the statements used (inferred from the refusal reasons).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#NotCertified">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#RefusalReasons"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:prefLabel xml:lang="en">not certified</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#RefusalAct">
    <skos:inScheme rdf:resource="https://w3id.org/cheezml/cubby#DialogueActs"/>
    <skos:prefLabel xml:lang="en">refusal (with reason)</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#ReviewerRoles">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <skos:prefLabel xml:lang="en">Reviewer roles</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cheezml/cubby#Refusal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/cheezml/cubby"/>
    <rdfs:label xml:lang="en">Refusal</rdfs:label>
    <skos:definition xml:lang="en">A refusal decision with a coded reason.</skos:definition>
